-- Existing counters are the baseline, not new session pickups.
do
    local main=Player.PlayerGui:FindFirstChild("MainGUI");local gameFrame=main and main:FindFirstChild("Game")
    local bagFrame=gameFrame and gameFrame:FindFirstChild("CoinBags");local container=bagFrame and bagFrame:FindFirstChild("Container")
    if container then
        for _,b in ipairs(container:GetChildren()) do
            if b:IsA("Frame") and b.Visible then
                S.currencies[b.Name]=true
                local c=b:FindFirstChild("CurrencyFrame");local icon=c and c:FindFirstChild("Icon");local count=icon and icon:FindFirstChild("Coins")
                local amount=count and tonumber(count.Text)
                if amount then
                    S.bags[b.Name]=amount
                    local f=b:FindFirstChild("Full");if amount>0 and f and f:IsA("GuiObject") and f.Visible then S.caps[b.Name]=amount end
                end
            end
        end
    end
end
event("CoinCollected",function(id,count,cap)
    if type(id)~="string" or type(count)~="number" then return end
    local delta=math.max(0,count-(S.bags[id] or 0));S.bags[id]=count;S.currencies[id]=true
    if type(cap)=="number" and cap>0 then S.caps[id]=cap end
    if delta>0 then
        S.total[id]=(S.total[id] or 0)+delta
        if cfg.Enabled or S.kind=="collect" then S.farmed[id]=(S.farmed[id] or 0)+delta end
        local _,root=character();local nearest,distance=nil,6
        if root then
            local target=S.target
            if target and target.Parent and target:GetAttribute("CoinID")==id and (root.Position-target.Position).Magnitude<6 then nearest=target end
            local preferred=nearest~=nil
            for _,part in ipairs(Tags:GetTagged("ServerCoinPart")) do
                if not preferred and part:IsA("BasePart") and part.Parent and not S.confirmed[part] and part:GetAttribute("CoinID")==id then
                    local d=(root.Position-part.Position).Magnitude;if d<distance then nearest,distance=part,d end
                end
            end
        end
        if nearest then S.confirmed[nearest]=visual(nearest) or true end
    end
    if full(id) and S.target and S.target:GetAttribute("CoinID")==id then
        if S.tween then S.tween:Cancel();S.tween=nil end
    end
end)
