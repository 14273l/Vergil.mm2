local function requestState()
    if S.requestPending or not gameplay then return end
    local remote=gameplay:FindFirstChild("GetCurrentPlayerData")
    if not remote or not remote:IsA("RemoteFunction") then return end
    S.requestPending=true;S.requestAt=os.clock()
    task.spawn(function()
        local ok,data=pcall(function() return remote:InvokeServer() end)
        S.requestPending=false;if S.alive and ok then ownData(data) end
    end)
end
task.spawn(function()
    local modules=RS:FindFirstChild("Modules")
    if not modules then requestState();return end
    local current=modules:FindFirstChild("CurrentRoundClient")
    if current then local ok,m=pcall(require,current);if ok and S.alive then ownData(m.PlayerData) end else requestState() end
    local p=modules:FindFirstChild("ProfileData");if p then local ok,m=pcall(require,p);if ok and S.alive then S.profile=m end end
    local l=modules:FindFirstChild("LevelModule");if l then local ok,m=pcall(require,l);if ok and S.alive then S.levels=m end end
end)
local function afkPulse()
