end
local function prestigeTick()
    if not cfg.AutoPrestige then S.prestigeStatus="Off";return end
    local p=profile()
    if S.prestigePending and p.prestige and p.prestige>S.prestigeTier then
        S.prestigePending=false;S.prestigeAttempts=0
        notify("Prestige "..p.prestige.." reached.")
    end
    if not p.level or p.prestige==nil then S.prestigeStatus="Waiting for profile";return end
    if p.prestige>=10 then S.prestigeStatus="Maximum prestige (X)";return end
    if p.level<100 then
        S.prestigeStatus=string.format("Level %d / needs 100",p.level)
        S.prestigePending=false;S.prestigeAttempts=0
        return
    end
    if S.prestigeAttempts>0 and os.clock()-S.prestigeAt<30 then S.prestigeStatus="Waiting for prestige update";return end
    if S.prestigeAttempts>=3 then S.prestigeStatus="Request not confirmed";return end
    local remotes=RS:FindFirstChild("Remotes")
    local inventory=remotes and remotes:FindFirstChild("Inventory")
    local remote=inventory and inventory:FindFirstChild("Prestige")
    if not remote or not remote:IsA("RemoteEvent") then S.prestigeStatus="Prestige unavailable";return end
    if not canPrestige() then return end
    -- Same no-argument request as MM2's native prestige confirmation button.
    local ok=pcall(function() remote:FireServer() end)
    S.prestigeAt=os.clock();S.prestigeAttempts=S.prestigeAttempts+1
    if ok then
        S.prestigeRequests=S.prestigeRequests+1;S.prestigePending=true;S.prestigeTier=p.prestige
