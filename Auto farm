connect(Run.Heartbeat,function(dt)
    clock=clock+dt;uiClock=uiClock+dt
    if clock>=0.15 then clock=0;farmTick() end
    if uiClock<0.5 then return end;uiClock=0
    S.map=nil
    for _,child in ipairs(workspace:GetChildren()) do
        if child.Name~="Lobby" and (child:IsA("Model") or child:IsA("Folder")) and child:FindFirstChild("CoinContainer") then S.map=child;break end
    end
    local p=profile();local collected,total=currencyText(S.total);local _,bagTotal=currencyText(S.bags)
    local maxTotal=0;for _,cap in pairs(S.caps) do maxTotal=maxTotal+cap end
    UI.status.Text=S.status.."\n"..S.phase.." / "..(S.map and S.map.Name or "Lobby")
    UI.stats.Text=collected..string.format("\n%.1f / minute",total*60/math.max(1,os.clock()-S.started))
    UI.bags.Text="Bags:\n"..currencyText(S.bags)
    UI.profile.Text=string.format("Level %s\nPrestige %s",p.level or "?",p.prestige or "?")
    prestigeTick()
    UI.prestige.Text=S.prestigeStatus
    UI.health.Text="Anti-AFK: "..(cfg.AntiAFK and (S.afkOK==false and "unavailable" or "on") or "off")
    if os.clock()>S.previewUntil then UI.report.Text=S.reportStatus..(cfg.Reports and string.format("\nNext in %ds",math.max(0,S.reportNext-os.clock())) or "") end
    bar.Visible=cfg.Enabled
    barTitle.Text=string.format("autofarm / %d/%s / %.0f st/s",bagTotal,maxTotal>0 and tostring(maxTotal) or "?",math.clamp(cfg.Speed,5,20))
    barStatus.Text=S.status:lower()
    local f=maxTotal>0 and math.clamp(bagTotal/maxTotal,0,1) or 0
    if math.abs(f-fraction)>0.001 then fraction=f;Tween:Create(fill,TweenInfo.new(0.15),{Size=UDim2.fromScale(f,1)}):Play() end
    footer.Text=cfg.Enabled and "autofarm on / X: stop" or "autofarm off"
    local ok,ping=pcall(function() return Player:GetNetworkPing() end)
    if ok and type(ping)=="number" and ping>0 then S.ping=S.ping*0.75+math.clamp(ping,0.005,1)*0.25 end
    if os.clock()-S.requestAt>12 then requestState() end
    if cfg.AntiAFK and os.clock()-S.lastAFK>60 then afkPulse() end
    if cfg.Reports and not S.reportBusy and os.clock()>=S.reportNext then sendReport(false) end
end)

