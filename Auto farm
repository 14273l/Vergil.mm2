local function collect(part)
    if S.busy or not aliveInRound() or not available(part) then return end
    local _,root,hum=character()
    S.token=S.token+1;local token=S.token
    S.busy=true;S.kind="collect";S.target=part
    S.status=part:GetAttribute("CoinID") or "Collecting"
    task.spawn(function()
        local ok=guard("collection",function()
            if token~=S.token or not available(part) then return end
            S.anchor=S.anchor or root.CFrame;S.point=part.Position;beginControl(root,hum)
            local head=Player.Character:FindFirstChild("Head")
            local contact=head and head:IsA("BasePart") and head or root
            local reach=contact.Position.Y-root.Position.Y+(contact.Size.Y+part.Size.Y)/2-0.1
            local depth=math.clamp(math.min(cfg.Depth,reach),0.2,5)
            local function valid() return aliveInRound() and part.Parent~=nil and available(part) end
            if not moveTo(root,part.Position-Vector3.new(0,depth,0),token,valid) then return end
            local id=part:GetAttribute("CoinID");local before=id and S.bags[id] or 0
            local deadline=os.clock()+math.clamp(S.ping*3+0.15,0.25,0.75)
            local last=-math.huge
            while S.alive and token==S.token and part.Parent and os.clock()<deadline do
                if S.confirmed[part] or (id and (S.bags[id] or 0)>before) then break end
                if (root.Position-part.Position).Magnitude<6 and os.clock()-last>0.15 and type(firetouchinterest)=="function" then
                    pcall(function() firetouchinterest(contact,part,0);firetouchinterest(contact,part,1) end)
                    last=os.clock()
                end
                task.wait(0.025)
            end
            if not S.confirmed[part] then S.retry[part]=os.clock()+2 end
        end)
        if token~=S.token then return end
        S.busy=false;S.kind=nil;S.target=nil
        if cfg.Enabled and aliveInRound() then S.hold=root.CFrame else restoreControl() end
        if not ok and part.Parent then S.retry[part]=os.clock()+2 end
        if cfg.Enabled then task.defer(function() guard("next coin",farmTick) end) end
    end)
end
farmTick=function()
    if S.busy or not cfg.Enabled then return end
    if not aliveInRound() then
        if S.original then cancel("Waiting for next round") end
        S.status="Waiting for next round";return
    end
    if finished() then
        if S.doneRound~=S.round then surface(true) else resetOnFull() end
        return
    end
    S.doneRound=nil
    local _,root=character();local best,distance,retry,earliest=nil,math.huge,nil,math.huge
    for _,part in ipairs(coins()) do
        local untilTime=S.retry[part] or 0
        if untilTime<=os.clock() then
            local d=(root.Position-part.Position).Magnitude
            if d<distance then best,distance=part,d end
        elseif untilTime<earliest then retry,earliest=part,untilTime end
    end
    best=best or retry
    if best then collect(best) else S.status="Waiting for coins to spawn" end
end

local onSetting
local function set(key,value)
    if defaults[key]==nil or type(value)~=type(defaults[key]) then return false end
    if limits[key] then if value~=value then return false end;value=math.clamp(value,limits[key][1],limits[key][2]) end
    local old=cfg[key];cfg[key]=value
    local t=UI.toggles[key];if t and t.Value~=value then t:Set(value) end
    local s=UI.sliders[key];if s and s.Value~=value then s:Set(value) end
    if onSetting and old~=value then onSetting(key,value) end
    return true
end
onSetting=function(key,value)
    if key=="Enabled" and not value then
        local returnToFloor=S.root~=nil and aliveInRound()
        cancel("Stopped")
        if returnToFloor then task.defer(function() if S.alive and not cfg.Enabled and not S.busy then surface(false) end end) end
    elseif key=="Enabled" and value then
        task.defer(function() guard("start",farmTick) end)
    elseif key=="Speed" or key=="Depth" then
        local returnToFloor=S.root~=nil and aliveInRound()
        cancel("Updating farm")
        if cfg.Enabled then task.defer(function() guard("resume",farmTick) end)
        elseif returnToFloor then task.defer(function() if S.alive and not S.busy then surface(false) end end) end
    elseif key=="Reports" then
        if value and S.webhook=="" then set("Reports",false);notify("Set your webhook URL first.") end
        S.reportNext=os.clock()+cfg.ReportInterval
    elseif key=="ReportInterval" then S.reportNext=os.clock()+value
    elseif key=="AutoPrestige" then
        S.prestigeStatus=value and "Checking level" or "Off"
        if value then S.prestigeAttempts=0;S.prestigeAt=-math.huge;S.prestigePending=false end
    end
end
local function currencyText(amounts)
    local keys,total={},0
    for id,n in pairs(amounts) do keys[#keys+1]=id;total=total+n end
    table.sort(keys)
    local lines={}
    for i=1,math.min(#keys,10) do
        local id=keys[i];local name=id=="Candy" and "Candies" or (id=="Coin" and "Coins" or id)
        lines[#lines+1]=string.format("%s: %d",name:gsub("[\r\n]"," "):sub(1,50),amounts[id])
    end
    return #lines>0 and table.concat(lines,"\n") or "None yet",total
end
local function profile()
    local p=S.profile or {};local xp=tonumber(p.NewXP) or tonumber(p.XP);local level=tonumber(p.Level)
    if xp and S.levels then local ok,n=pcall(S.levels.GetLevel,xp);if ok then level=n end end
    return {level=level,prestige=tonumber(p.Prestige),xp=xp}
end
local function canPrestige()
    local p=profile()
