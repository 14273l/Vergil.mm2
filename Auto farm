    if hum.RigType==Enum.HumanoidRigType.R6 then
        local leg=Player.Character:FindFirstChild("Left Leg") or Player.Character:FindFirstChild("Right Leg")
        height=height+(leg and leg.Size.Y or 2)
    end
    local point=S.point
    if not point then
        point=hum.FloorMaterial==Enum.Material.Air and root.Position+Vector3.new(0,cfg.Depth,0)
            or root.Position-Vector3.new(0,height-0.25,0)
    end
    if not completed then point=Vector3.new(root.Position.X,point.Y,root.Position.Z) end
    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
    local ignore={}
    for _,p in ipairs(Players:GetPlayers()) do if p.Character then ignore[#ignore+1]=p.Character end end
    local container=S.map and S.map:FindFirstChild("CoinContainer")
    if container then ignore[#ignore+1]=container end
    params.FilterDescendantsInstances=ignore
    local hit=workspace:Raycast(point+Vector3.new(0,2,0),Vector3.new(0,-64,0),params)
    local goal=hit and hit.Normal.Y>0.35 and Vector3.new(point.X,hit.Position.Y+height+0.2,point.Z)
        or (S.anchor and S.anchor.Position or point+Vector3.new(0,height,0))
    S.token=S.token+1;local token=S.token
