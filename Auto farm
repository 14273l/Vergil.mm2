local function moveTo(root,goal,token,valid)
    if not S.alive or token~=S.token or not valid() then return false end
    local distance=(root.Position-goal).Magnitude
    if distance<0.1 then S.hold=root.CFrame;return true end
    local speed=math.clamp(cfg.Speed,5,20)
    local duration=math.max(distance/speed,0.025)
    S.leg={distance=distance,duration=duration,speed=speed,targetY=goal.Y}
    local tween=Tween:Create(root,TweenInfo.new(duration,Enum.EasingStyle.Linear),{CFrame=CFrame.new(goal)*root.CFrame.Rotation})
    S.hold=nil;S.tween=tween;tween:Play()
    while tween.PlaybackState==Enum.PlaybackState.Playing do
        if not S.alive or token~=S.token or not valid() then tween:Cancel();break end
        task.wait(0.025)
    end
    local reached=tween.PlaybackState==Enum.PlaybackState.Completed
    if S.tween==tween then S.tween=nil end
    if token==S.token then S.hold=root.CFrame end
    return reached
end
