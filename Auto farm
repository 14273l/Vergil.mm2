local function validWebhook(url)
    return type(url)=="string" and (url:match("^https://discord%.com/api/webhooks/%d+/[%w_%-]+$")~=nil
        or url:match("^https://discordapp%.com/api/webhooks/%d+/[%w_%-]+$")~=nil
        or url:match("^https://canary%.discord%.com/api/webhooks/%d+/[%w_%-]+$")~=nil
        or url:match("^https://ptb%.discord%.com/api/webhooks/%d+/[%w_%-]+$")~=nil)
end
local function setWebhook(url)
    url=tostring(url or ""):match("^%s*(.-)%s*$")
    if url~="" and not validWebhook(url) then S.reportStatus="Invalid Discord URL";return false end
    S.webhook=url;S.reportStatus=url=="" and "No URL set" or "URL ready"
    S.reportNext=os.clock()+cfg.ReportInterval
    if url=="" then set("Reports",false) end
    return true
end
local function sendReport(manual)
    if S.reportBusy then return false,"Already sending" end
    if not manual and not cfg.Reports then return false,"Reports disabled" end
    if not validWebhook(S.webhook) then S.reportStatus="Set a webhook URL first";S.reportNext=os.clock()+cfg.ReportInterval;return false,S.reportStatus end
    if os.clock()-S.reportAt<5 then return false,"Please wait before sending again" end
    local requestFn=request or http_request or (syn and syn.request)
    if type(requestFn)~="function" then S.reportStatus="HTTP request unavailable";S.reportNext=os.clock()+60;return false,S.reportStatus end
    local body=Http:JSONEncode(payload());local url=S.webhook
    S.reportBusy=true;S.reportAt=os.clock();S.reportStatus="Sending…"
    task.spawn(function()
        local ok,response=pcall(requestFn,{Url=url,Method="POST",Headers={["Content-Type"]="application/json"},Body=body})
        S.reportBusy=false;if not S.alive then return end
        local code=ok and type(response)=="table" and tonumber(response.StatusCode or response.Status) or nil
        S.reportNext=os.clock()+cfg.ReportInterval
        if code and code>=200 and code<300 then S.reportStatus="Sent · "..os.date("%H:%M:%S")
        elseif code==429 then
            local retry=60;pcall(function() retry=tonumber(Http:JSONDecode(response.Body).retry_after) or 60 end)
            S.reportNext=os.clock()+math.max(cfg.ReportInterval,retry+1);S.reportStatus="Rate limited · waiting"
        elseif code==401 or code==403 or code==404 then set("Reports",false);S.reportStatus="Webhook rejected ("..code..")"
        else S.reportStatus=code and "HTTP "..code or "Request failed";S.reportNext=os.clock()+math.max(60,cfg.ReportInterval) end
        if manual then notify(S.reportStatus) end
    end)
    return true
end
